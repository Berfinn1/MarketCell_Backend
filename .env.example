# =============================================================================
# MarketCell — ortam değişkenleri
# Kullanım: Bu dosyayı MarketCell_Backend/.env olarak kopyalayın ve değerleri doldurun.
# =============================================================================

# API
PORT=3000

# PostgreSQL
DB_HOST=localhost
DB_PORT=5432
DB_NAME=marketcell
DB_USER=postgres
DB_PASSWORD=your_password_here

# JWT (üretimde güçlü rastgele değerler kullanın)
JWT_ACCESS_SECRET=change_me_access_secret_min_32_chars
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# CORS — virgülle ayrılmış kökenler (ASP.NET yerel URL’leri)
# Örnek: http://localhost:5034,https://localhost:7125
CORS_ORIGINS=http://localhost:5034,https://localhost:7125,http://localhost:14116,https://localhost:44327

# -----------------------------------------------------------------------------
# ASP.NET MVC (frontend) — bağlantı adresi appsettings içindedir, örnek:
#   "MarketCellApi": { "BaseUrl": "http://localhost:3000" }
# -----------------------------------------------------------------------------
